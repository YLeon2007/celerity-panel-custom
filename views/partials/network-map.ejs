<%
// Match the client namespace (no leading `network.`); don't serialize panel settings.
const labels = [
    'refresh', 'loadingTopology', 'noNodesOrLinks', 'networkError', 'openNode', 'routePath',
    'mkcpAppliedUnverified', 'mkcpRuntimeUnsupported', 'mkcpApplyUnconfirmed',
    'deploySuccess', 'deployFailed', 'chainDeploySuccess', 'chainDeployFailed', 'deleteSuccess',
    'csrfTokenInvalid', 'csrfTokenRefreshed', 'csrfAuthRequired', 'csrfOriginInvalid', 'csrfSavedDraft',
    'positionsSaved', 'positionsSaveFailed', 'positionsSaveSessionChanged',
];
const networkI18n = Object.fromEntries(labels.map(key => [key, t(`network.${key}`)]));
networkI18n.portalExitSettings = t('network.map.portalExitSettings');
networkI18n.tunnelUnknown = t('network.map.tunnelUnknown');
networkI18n.terminal = t('nodes.terminal');
networkI18n.sshNotConfigured = t('nodes.sshNotConfigured');
networkI18n.map = locales.network.map;
const scriptJson = value => JSON.stringify(value).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
const panelToken = typeof csrfToken === 'string' ? csrfToken : '';
const canSavePositions = typeof c3Rebuild !== 'undefined' && c3Rebuild === true && panelToken;
%>
<link rel="stylesheet" href="/css/network-map.css?v=fa65def33febe72a">
<script type="application/json" id="networkI18n"><%- scriptJson(networkI18n) %></script>
<% if (panelToken) { %>
<script>window._networkCsrfToken = <%- scriptJson(panelToken) %>;</script>
<% } %>
<div class="nm-read-only-note">
    <p><%= t(panelToken ? 'network.map.linkEditNotice' : 'network.map.readOnlyNotice') %></p>
    <a class="btn btn-sm btn-primary" href="/panel/nodes?map=classic"><%= t('network.map.openClassic') %></a>
</div>
<div class="network-page" id="networkRoot"<% if (panelToken) { %> data-link-actions="true"<% } else { %> data-read-only="true"<% } %><% if (canSavePositions) { %> data-save-positions="true"<% } %>>
    <div class="nm-bar"></div>
    <div class="nm-body">
        <div class="nm-stage"></div>
        <aside class="nm-insp" aria-label="<%= t('network.map.inspector') %>"></aside>
        <div class="nm-state" role="status">
            <i class="ti ti-loader-2 nm-spin" aria-hidden="true"></i>
            <p><%= t('network.loadingTopology') %></p>
        </div>
    </div>
</div>
