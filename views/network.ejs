<link rel="stylesheet" href="/css/network.min.css">

<div class="network-page">
    <div class="network-toolbar">
        <div class="toolbar-left">
            <h2 class="toolbar-title"><i class="ti ti-topology-star-3"></i> <%= t('network.title') %></h2>
            <span class="toolbar-badge"><%= nodesCount %> <%= t('network.nodes') %></span>
            <span class="toolbar-badge"><%= linksCount %> <%= t('network.links') %></span>
        </div>
        <div class="toolbar-right">
            <button class="btn btn-sm btn-outline" id="btnAutoLayout" title="<%= t('network.autoLayout') %>">
                <i class="ti ti-layout-distribute-horizontal"></i> <%= t('network.autoLayout') %>
            </button>
            <button class="btn btn-sm btn-outline" id="btnFitView" title="<%= t('network.fitView') %>">
                <i class="ti ti-arrows-maximize"></i>
            </button>
            <button class="btn btn-sm btn-outline" id="btnRefresh" title="<%= t('network.refresh') %>">
                <i class="ti ti-refresh"></i>
            </button>
            <button class="btn btn-sm btn-primary" id="btnAddLink">
                <i class="ti ti-plus"></i> <%= t('network.addLink') %>
            </button>
        </div>
    </div>

    <div id="topologyReentryNotice" hidden>
        <button type="button" class="btn btn-sm btn-outline" disabled>Повторно включить any-order</button>
        <span role="status"></span>
    </div>
    <div class="network-container">
        <div id="cy" class="cytoscape-canvas"></div>
        <div class="network-minimap" id="minimap"></div>

        <!-- Node detail drawer -->
        <div class="network-drawer" id="nodeDrawer">
            <div class="drawer-header">
                <h3 id="drawerTitle"></h3>
                <button class="drawer-close" id="drawerClose"><i class="ti ti-x"></i></button>
            </div>
            <div class="drawer-body" id="drawerBody"></div>
        </div>
    </div>

    <div class="modal-overlay" id="nodeInfoModal">
        <div class="modal-card modal-card-sm">
            <div class="modal-header">
                <h3 id="nodeInfoTitleText"></h3>
                <button type="button" class="modal-close" id="nodeInfoClose" aria-label="<%= t('common.close') %>"><i class="ti ti-x"></i></button>
            </div>
            <div class="modal-body" id="nodeInfoBody"></div>
        </div>
    </div>

    <!-- Add Link Modal -->
    <div class="modal-overlay" id="addLinkModal">
        <div class="modal-card">
            <div class="modal-header">
                <h3><i class="ti ti-link"></i> <span id="linkModalTitle"><%= t('network.addLink') %></span></h3>
                <button class="modal-close" id="modalClose"><i class="ti ti-x"></i></button>
            </div>
            <form id="addLinkForm" class="modal-body">
                <input type="hidden" id="linkIdInput" name="linkId">
                <input type="hidden" id="linkModeInput" name="mode" value="reverse">
                <div class="form-group">
                    <label><%= t('network.linkName') %></label>
                    <input type="text" name="name" class="form-input" required placeholder="e.g. YandexCloud → France">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label><%= t('network.portalNode') %></label>
                        <select name="portalNodeId" class="form-input" id="selectPortal" required></select>
                    </div>
                    <div class="form-group">
                        <label><%= t('network.bridgeNode') %></label>
                        <select name="bridgeNodeId" class="form-input" id="selectBridge" required></select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label><%= t('network.tunnelPort') %></label>
                        <input type="number" name="tunnelPort" class="form-input" value="10086" min="1" max="65535">
                    </div>
                    <div class="form-group">
                        <label><%= t('network.tunnelProtocol') %></label>
                        <select name="tunnelProtocol" class="form-input">
                            <option value="vless">VLESS</option>
                            <option value="vmess">VMess</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label><%= t('network.tunnelTransport') %></label>
                        <select name="tunnelTransport" class="form-input" id="selectTransport">
                            <option value="tcp">TCP</option>
                            <option value="ws">WebSocket</option>
                            <option value="grpc">gRPC</option>
                            <option value="xhttp">XHTTP (SplitHTTP)</option>
                            <% if (typeof c3Rebuild !== 'undefined' && c3Rebuild) { %><option value="kcp"><%= t('network.kcpTransport') %></option><% } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label><%= t('network.tunnelSecurity') %></label>
                        <select id="selectSecurity" name="tunnelSecurity" class="form-input">
                            <option value="none"><%= t('common.none') %></option>
                            <option value="tls">TLS</option>
                            <% if (typeof c3Rebuild !== 'undefined' && c3Rebuild) { %><option value="reality" selected>REALITY</option><% } %>
                        </select>
                    </div>
                </div>
                <% if (typeof c3Rebuild !== 'undefined' && c3Rebuild) { %>
                    <%- include('partials/network-kcp') %>
                <% } else { %>
                    <p class="form-hint"><%= t('network.classicKcpRebuildOnly') %></p>
                <% } %>
                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" name="autoDeploy" checked>
                        <span id="linkAutoDeployLabel"><%= t('network.autoDeploy') || 'Auto-deploy chain after creation' %></span>
                    </label>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-outline" id="modalCancel"><%= t('common.cancel') %></button>
                    <button type="submit" class="btn btn-primary" id="linkModalSubmit"><i class="ti ti-plus"></i> <%= t('network.createLink') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.30.4/cytoscape.min.js" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/dagre/0.8.5/dagre.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/cytoscape-dagre@2.5.0/cytoscape-dagre.min.js" crossorigin="anonymous"></script>
<% if (typeof c3Rebuild !== 'undefined' && c3Rebuild) { %>
<%- include('partials/rebuild-preview') %>
<% } %>
<script>
window._c3Rebuild = <%= typeof c3Rebuild !== 'undefined' && c3Rebuild ? 'true' : 'false' %>;
window._networkCsrfToken = <%- JSON.stringify(typeof csrfToken === 'string' ? csrfToken : '') %>;
window._networkI18n = {
    kcpTransport: <%- JSON.stringify(t('network.kcpTransport')) %>,
    kcpInvalidLink: <%- JSON.stringify(t('network.kcpInvalidLink')) %>,
    classicKcpRebuildOnly: <%- JSON.stringify(t('network.classicKcpRebuildOnly')) %>,
    portCheckChecking: <%- JSON.stringify(t('network.portCheckChecking')) %>,
    portCheckOccupied: <%- JSON.stringify(t('network.portCheckOccupied')) %>,
    portCheckUnknown: <%- JSON.stringify(t('network.portCheckUnknown')) %>,
    portCheckAvailable: <%- JSON.stringify(t('network.portCheckAvailable')) %>,
    portCheckDeployConflict: <%- JSON.stringify(t('network.portCheckDeployConflict')) %>,
    rebuildCoreTooOld: <%- JSON.stringify(t('network.rebuildCoreTooOld')) %>,
    rebuildCoreVersionUnknown: <%- JSON.stringify(t('network.rebuildCoreVersionUnknown')) %>,
    editLink: <%- JSON.stringify(t('network.editLink')) %>,
    addLink: <%- JSON.stringify(t('network.addLink')) %>,
    createLink: <%- JSON.stringify(t('network.createLink')) %>,
    autoDeploy: <%- JSON.stringify(t('network.autoDeploy')) %>,
    deployAfterEdit: <%- JSON.stringify(t('network.deployAfterEdit')) %>,
    saveAndDeploy: <%- JSON.stringify(t('network.saveAndDeploy')) %>,
    edit: <%- JSON.stringify(t('common.edit')) %>,
    save: <%- JSON.stringify(t('common.save')) %>,
    savedApplyUnconfirmed: <%- JSON.stringify(t('network.savedApplyUnconfirmed')) %>,
    networkError: <%- JSON.stringify(t('network.networkError')) %>,
    csrfTokenInvalid: <%- JSON.stringify(t('network.csrfTokenInvalid')) %>,
    csrfTokenRefreshed: <%- JSON.stringify(t('network.csrfTokenRefreshed')) %>,
    csrfAuthRequired: <%- JSON.stringify(t('network.csrfAuthRequired')) %>,
    csrfOriginInvalid: <%- JSON.stringify(t('network.csrfOriginInvalid')) %>,
    csrfSavedDraft: <%- JSON.stringify(t('network.csrfSavedDraft')) %>,
    mkcpAppliedUnverified: <%- JSON.stringify(t('network.mkcpAppliedUnverified')) %>,
    mkcpRuntimeUnsupported: <%- JSON.stringify(t('network.mkcpRuntimeUnsupported')) %>,
    mkcpApplyUnconfirmed: <%- JSON.stringify(t('network.mkcpApplyUnconfirmed')) %>,
};
</script>
<% if (typeof c3Rebuild !== 'undefined' && c3Rebuild) { %>
<script src="/js/network.js?v=56ac1f773cd644f9"></script>
<% } else { %><script src="/js/network.min.js?v=ed888b4c279134a0"></script><% } %>
