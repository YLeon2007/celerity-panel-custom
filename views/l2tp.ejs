<style>
.l2tp-simple { max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }
.l2tp-simple .card { background: var(--card-bg, #1e1e2e); border: 1px solid var(--border-color, #2e2e3e); border-radius: 10px; padding: 18px 20px; }
.l2tp-simple h2 { margin: 0 0 14px; font-size: 17px; display: flex; align-items: center; gap: 8px; }
.l2tp-row { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-top: 1px solid var(--border-color, #2e2e3e); flex-wrap: wrap; }
.l2tp-row:first-of-type { border-top: none; }
.l2tp-row .grow { flex: 1; min-width: 140px; }
.l2tp-name { font-weight: 600; }
.badge { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 12px; }
.badge-ok { background: rgba(46, 204, 113, .15); color: #2ecc71; }
.badge-off { background: rgba(255, 255, 255, .08); color: #999; }
.badge-warn { background: rgba(241, 196, 15, .15); color: #f1c40f; }
.badge-err { background: rgba(231, 76, 60, .15); color: #e74c3c; }
.psk-chip { font-family: monospace; font-size: 12px; color: #e8e8f2; background: rgba(255,255,255,.10); border: 1px dashed var(--border-color, #2e2e3e); border-radius: 6px; padding: 4px 10px; cursor: pointer; user-select: none; max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.psk-chip:hover { border-color: #4a9eff; }
.relay-chips { display: flex; gap: 6px; flex-wrap: wrap; }
.relay-chip { font-size: 12px; background: rgba(74, 158, 255, .12); color: #4a9eff; border-radius: 6px; padding: 2px 8px; }
.l2tp-form { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; }
.l2tp-form input { background: rgba(255,255,255,.05); border: 1px solid var(--border-color, #2e2e3e); color: inherit; border-radius: 6px; padding: 8px 12px; min-width: 180px; }
.l2tp-status-line { min-height: 20px; font-size: 13px; margin-top: 8px; opacity: .85; }
.l2tp-empty { opacity: .55; font-size: 14px; padding: 8px 0; }
</style>

<div class="l2tp-simple">
    <div class="card">
        <h2><i class="ti ti-server-2"></i> <%= t('l2tp.relays') %></h2>
        <div id="relayList"><div class="l2tp-empty"><%= t('l2tp.loading') %></div></div>
        <div class="l2tp-status-line" id="relayStatus"></div>
    </div>

    <div class="card">
        <h2><i class="ti ti-users"></i> <%= t('l2tp.accounts') %></h2>
        <form class="l2tp-form" id="accountForm">
            <input type="text" id="accountLogin" placeholder="<%= t('l2tp.login') %>" autocomplete="off" required>
            <input type="text" id="accountPassword" placeholder="<%= t('l2tp.passwordPlaceholder') %>" autocomplete="new-password">
            <button type="submit" class="btn btn-primary"><i class="ti ti-plus"></i> <%= t('l2tp.createAccount') %></button>
        </form>
        <div id="accountList"></div>
        <div class="l2tp-status-line" id="accountStatus"></div>
    </div>
</div>

<script>
(() => {
    'use strict';
    const csrfToken = <%- JSON.stringify(csrfToken || '') %>;
    const L = <%- JSON.stringify({
        install: t('l2tp.install'),
        uninstall: t('l2tp.uninstall'),
        confirmUninstall: t('l2tp.confirmUninstall'),
        installed: t('l2tp.installed'),
        notInstalled: t('l2tp.notInstalled'),
        installing: t('l2tp.installing'),
        online: t('l2tp.online'),
        offline: t('l2tp.offline'),
        copyPsk: t('l2tp.copyPsk'),
        copyPassword: t('l2tp.copyPassword'),
        copied: t('l2tp.copied'),
        noAccounts: t('l2tp.noAccounts'),
        deleteAccount: t('l2tp.deleteAccount'),
        confirmDeleteAccount: t('l2tp.confirmDeleteAccount'),
        pendingSync: t('l2tp.pendingSync'),
        synced: t('l2tp.synced'),
        copyLogin: t('l2tp.copyLogin'),
        requestFailed: t('l2tp.requestFailed'),
        rateLimited: t('l2tp.rateLimited'),
        queued: t('l2tp.queued'),
        done: t('l2tp.done'),
        failed: t('l2tp.failed'),
    }) %>;

    const relayList = document.getElementById('relayList');
    const relayStatus = document.getElementById('relayStatus');
    const accountList = document.getElementById('accountList');
    const accountStatus = document.getElementById('accountStatus');
    const accountForm = document.getElementById('accountForm');
    const pollers = new Map();

    function esc(value) {
        return String(value ?? '').replace(/[&<>"']/g, ch => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
        }[ch]));
    }

    async function api(path, options = {}) {
        const response = await fetch(path, {
            ...options,
            headers: {
                'x-csrf-token': csrfToken,
                ...(options.body ? { 'Content-Type': 'application/json' } : {}),
                ...(options.headers || {}),
            },
        });
        let payload = null;
        try { payload = await response.json(); } catch { /* empty body */ }
        if (!response.ok) {
            const code = payload?.error?.code
                || payload?.code
                || (response.status === 429 ? 'RATE_LIMITED' : 'REQUEST_FAILED');
            const error = new Error(code);
            error.code = code;
            throw error;
        }
        return payload;
    }

    function fmtError(error) {
        return error?.code === 'RATE_LIMITED'
            ? L.rateLimited
            : `${L.requestFailed}: ${error?.code || 'REQUEST_FAILED'}`;
    }

    function relayBadge(relay) {
        if (relay.installed) {
            return `<span class="badge badge-ok">${esc(L.installed)}</span>`;
        }
        if (relay.configured && relay.status !== 'not_installed') {
            return `<span class="badge badge-warn">${esc(L.installing)}</span>`;
        }
        return `<span class="badge badge-off">${esc(L.notInstalled)}</span>`;
    }

    function relayButton(relay) {
        if (relay.installed) {
            return `<button class="btn btn-sm btn-outline" data-action="uninstall">${esc(L.uninstall)}</button>`;
        }
        if (relay.configured && relay.status !== 'not_installed') {
            return `<button class="btn btn-sm btn-primary" disabled>${esc(L.installing)}</button>`;
        }
        return `<button class="btn btn-sm btn-primary" data-action="install">${esc(L.install)}</button>`;
    }

    function renderRelays(relays) {
        if (!relays.length) {
            relayList.innerHTML = `<div class="l2tp-empty">${esc(L.noAccounts)}</div>`;
            return;
        }
        relayList.innerHTML = relays.map(relay => `
            <div class="l2tp-row" data-node="${esc(relay.id)}">
                <span class="l2tp-name grow">${esc(relay.name)}
                    <span class="badge ${relay.online ? 'badge-ok' : 'badge-err'}">${esc(relay.online ? L.online : L.offline)}</span>
                </span>
                ${relayBadge(relay)}
                ${relay.psk
                    ? `<span class="psk-chip" data-psk="${esc(relay.psk)}" title="${esc(L.copyPsk)}">${esc(relay.psk)}</span>`
                    : ''}
                ${relayButton(relay)}
            </div>
        `).join('');
    }

    function renderAccounts(accounts) {
        if (!accounts.length) {
            accountList.innerHTML = `<div class="l2tp-empty">${esc(L.noAccounts)}</div>`;
            return;
        }
        accountList.innerHTML = accounts.map(account => `
            <div class="l2tp-row" data-login="${esc(account.login)}">
                <span class="l2tp-name grow">
                    <button class="psk-chip" data-psk="${esc(account.login)}"
                        title="${esc(L.copyLogin)}">${esc(account.login)}</button>
                    ${account.pending
                        ? `<span class="badge badge-warn">${esc(L.pendingSync)}</span>`
                        : `<span class="badge badge-ok">${esc(L.synced)}</span>`}
                </span>
                ${account.password
                    ? `<button class="psk-chip" data-psk="${esc(account.password)}"
                        title="${esc(L.copyPassword)}">${esc(account.password)}</button>`
                    : '<span class="l2tp-empty">—</span>'}
                <span class="relay-chips">${account.relays.map(relay =>
                    `<span class="relay-chip">${esc(relay.name)} · ${esc(relay.ip)}</span>`).join('')}
                </span>
                <button class="btn btn-sm btn-outline" data-action="delete-account">${esc(L.deleteAccount)}</button>
            </div>
        `).join('');
    }

    let syncTimer = null;

    async function refresh() {
        try {
            const data = await api('/panel/l2tp/simple/overview');
            renderRelays(data.relays || []);
            renderAccounts(data.accounts || []);
            // While any account is syncing, keep polling so the badge flips
            // to "synced" without a manual page reload.
            const pending = (data.accounts || []).some(account => account.pending)
                || (data.relays || []).some(relay => relay.configured && !relay.installed && relay.status !== 'not_installed');
            if (pending && !syncTimer) {
                syncTimer = setTimeout(() => { syncTimer = null; refresh(); }, 3000);
            }
        } catch (error) {
            relayStatus.textContent = fmtError(error);
        }
    }

    async function pollOperation(operationId, nodeId) {
        if (pollers.has(operationId)) return;
        pollers.set(operationId, nodeId);
        try {
            for (let attempt = 0; attempt < 240; attempt += 1) {
                await new Promise(resolve => setTimeout(resolve, 3000));
                const operation = await api(`/panel/l2tp/operations/${operationId}`);
                if (operation.status === 'succeeded') {
                    relayStatus.textContent = L.done;
                    break;
                }
                if (operation.status === 'failed' || operation.status === 'rolled_back') {
                    relayStatus.textContent = `${L.failed}: ${operation.errorCode || ''}`;
                    break;
                }
                relayStatus.textContent = `${L.queued} (${operation.progress || 0}%)`;
            }
        } catch { /* keep last status */ } finally {
            pollers.delete(operationId);
            refresh();
        }
    }

    relayList.addEventListener('click', async event => {
        const pskChip = event.target.closest('.psk-chip');
        if (pskChip) {
            try {
                await navigator.clipboard.writeText(pskChip.dataset.psk);
                relayStatus.textContent = L.copied;
            } catch {
                const range = document.createRange();
                range.selectNodeContents(pskChip);
                const selection = window.getSelection();
                selection.removeAllRanges();
                selection.addRange(range);
            }
            return;
        }
        const button = event.target.closest('button[data-action]');
        if (!button) return;
        const row = button.closest('.l2tp-row');
        const nodeId = row?.dataset.node;
        if (!nodeId) return;
        if (button.dataset.action === 'uninstall' && !window.confirm(L.confirmUninstall)) return;
        button.disabled = true;
        relayStatus.textContent = '';
        try {
            if (button.dataset.action === 'install') {
                const result = await api(`/panel/l2tp/simple/relays/${nodeId}/install`, { method: 'POST', body: '{}' });
                relayStatus.textContent = L.queued;
                if (result?.operationId) pollOperation(result.operationId, nodeId);
            } else {
                await api(`/panel/l2tp/simple/relays/${nodeId}/uninstall`, { method: 'POST', body: '{}' });
                relayStatus.textContent = L.done;
            }
            await refresh();
        } catch (error) {
            relayStatus.textContent = fmtError(error);
            button.disabled = false;
        }
    });

    accountForm.addEventListener('submit', async event => {
        event.preventDefault();
        const login = document.getElementById('accountLogin').value.trim();
        const password = document.getElementById('accountPassword').value;
        accountStatus.textContent = '';
        try {
            await api('/panel/l2tp/simple/accounts', {
                method: 'POST',
                body: JSON.stringify({ login, password }),
            });
            accountForm.reset();
            accountStatus.textContent = L.done;
            refresh();
        } catch (error) {
            accountStatus.textContent = fmtError(error);
        }
    });

    accountList.addEventListener('click', async event => {
        const pskChip = event.target.closest('.psk-chip');
        if (pskChip) {
            try {
                await navigator.clipboard.writeText(pskChip.dataset.psk);
                accountStatus.textContent = L.copied;
            } catch {
                const range = document.createRange();
                range.selectNodeContents(pskChip);
                const selection = window.getSelection();
                selection.removeAllRanges();
                selection.addRange(range);
            }
            return;
        }
        const button = event.target.closest('button[data-action="delete-account"]');
        if (!button) return;
        const login = button.closest('.l2tp-row')?.dataset.login;
        if (!login || !window.confirm(`${L.confirmDeleteAccount} "${login}"?`)) return;
        button.disabled = true;
        accountStatus.textContent = '';
        try {
            await api(`/panel/l2tp/simple/accounts/${encodeURIComponent(login)}/delete`, { method: 'POST', body: '{}' });
            accountStatus.textContent = L.done;
            refresh();
        } catch (error) {
            accountStatus.textContent = fmtError(error);
            button.disabled = false;
        }
    });

    refresh();
})();
</script>
