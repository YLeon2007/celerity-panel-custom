<section class="page-header">
    <div>
        <h1>L2TP/IPsec Relay</h1>
        <p class="muted">Topology revision: <strong><%= topologyRevision %></strong></p>
    </div>
</section>

<section class="card">
    <h2>Relay nodes</h2>
    <% if (!relays || relays.length === 0) { %>
        <p class="muted">No relay nodes are available.</p>
    <% } %>
    <% for (const relay of (relays || [])) { %>
        <article class="card" data-l2tp-relay data-node-id="<%= relay.id %>">
            <h3><%= relay.name || relay.id %></h3>
            <p>
                Node: <%= relay.nodeStatus || 'unknown' %> ·
                L2TP: <%= relay.l2tpStatus %> ·
                Desired: <%= relay.desiredState %>
            </p>
            <form data-l2tp-form>
                <input type="hidden" name="expectedTopologyRevision" value="<%= topologyRevision %>">
                <label>Client CIDR
                    <input type="text" name="clientCidr" value="<%= relay.clientCidr || '' %>" placeholder="10.77.0.0/24" required>
                </label>
                <label>Local IP
                    <input type="text" name="localAddress" value="<%= relay.localAddress || '' %>" placeholder="10.77.0.1" required>
                </label>
                <label>Pool start
                    <input type="text" name="poolStart" value="<%= relay.poolStart || '' %>" placeholder="10.77.0.10" required>
                </label>
                <label>Pool end
                    <input type="text" name="poolEnd" value="<%= relay.poolEnd || '' %>" placeholder="10.77.0.200" required>
                </label>
                <label>DNS servers
                    <input type="text" name="dnsServers" value="<%= (relay.dnsServers || []).join(', ') %>" placeholder="1.1.1.1, 9.9.9.9" required>
                </label>
                <label>TPROXY port
                    <input type="number" name="tproxyPort" value="<%= relay.tproxyPort ?? '' %>" min="1" max="65535" step="1" placeholder="12345" required>
                </label>
                <label>Firewall mark
                    <input type="number" name="fwmark" value="<%= relay.fwmark ?? '' %>" min="1" max="4294967295" step="1" placeholder="77" required>
                </label>
                <label>Route table
                    <input type="number" name="routeTable" value="<%= relay.routeTable ?? '' %>" min="1" max="4294967295" step="1" placeholder="177" required>
                </label>
                <label>Route group
                    <select name="routeGroupId" required>
                        <option value="">Select route group</option>
                        <% for (const group of (routeGroups || [])) { %>
                            <option value="<%= group.id %>" <%= relay.routeGroupId === group.id ? 'selected' : '' %>>
                                <%= group.name %> (<%= group.mode %>, <%= group.strategy %>)
                            </option>
                        <% } %>
                    </select>
                </label>
                <div class="form-actions">
                    <button type="button" data-l2tp-action="configure">Save desired state</button>
                    <button type="button" data-l2tp-action="preflight">Preflight</button>
                    <button type="button" data-l2tp-action="install">Queue install</button>
                </div>
                <output data-l2tp-result aria-live="polite"></output>
            </form>
            <section data-l2tp-users>
                <h4>L2TP users</h4>
                <form data-l2tp-user-form autocomplete="off">
                    <label>Login
                        <input type="text" name="login" maxlength="64" required>
                    </label>
                    <label>Client IP
                        <input type="text" name="ip" placeholder="10.77.0.10" required>
                    </label>
                    <label>Password
                        <input type="password" name="password" autocomplete="new-password" maxlength="1024" required>
                    </label>
                    <label>
                        <input type="checkbox" name="enabled" checked>
                        Enabled
                    </label>
                    <button type="submit" data-l2tp-user-action="create">Add user</button>
                </form>
                <p class="muted" data-l2tp-user-empty>Loading users…</p>
                <div data-l2tp-user-list></div>
                <template data-l2tp-user-row>
                    <div class="card">
                        <code data-l2tp-user-login></code>
                        <span data-l2tp-user-ip></span>
                        <span data-l2tp-user-status></span>
                        <span data-l2tp-user-sync></span>
                        <button type="button" data-l2tp-user-action="toggle"></button>
                    </div>
                </template>
                <output data-l2tp-user-result aria-live="polite"></output>
            </section>
        </article>
    <% } %>
</section>

<section class="card">
    <h2>Recent operations</h2>
    <% if (!operations || operations.length === 0) { %>
        <p class="muted">No operations.</p>
    <% } else { %>
        <ul>
            <% for (const operation of operations) { %>
                <li>
                    <code><%= operation.id %></code> — <%= operation.kind %> / <%= operation.status %>
                    (<%= operation.progress %>%)
                    <%= operation.errorCode ? ` — ${operation.errorCode}` : '' %>
                </li>
            <% } %>
        </ul>
    <% } %>
</section>

<script>
(() => {
    const csrfToken = <%- JSON.stringify(csrfToken || '') %>;

    function setResult(output, value) {
        output.textContent = value;
    }

    function buildOperationPayload(values) {
        return {
            clientCidr: String(values.clientCidr || '').trim(),
            dnsServers: String(values.dnsServers || '').split(',').map((item) => item.trim()).filter(Boolean),
            routeGroupId: String(values.routeGroupId || ''),
            expectedTopologyRevision: Number(values.expectedTopologyRevision),
        };
    }

    function buildConfigurePayload(values) {
        return {
            clientCidr: String(values.clientCidr || '').trim(),
            localAddress: String(values.localAddress || '').trim(),
            poolStart: String(values.poolStart || '').trim(),
            poolEnd: String(values.poolEnd || '').trim(),
            dnsServers: String(values.dnsServers || '').split(',').map((item) => item.trim()).filter(Boolean),
            tproxyPort: Number(values.tproxyPort),
            fwmark: Number(values.fwmark),
            routeTable: Number(values.routeTable),
            routeGroupId: String(values.routeGroupId || ''),
            generatePsk: true,
        };
    }

    function buildL2tpUserPayload(values) {
        return {
            login: String(values.login || '').trim(),
            ip: String(values.ip || '').trim(),
            password: String(values.password || ''),
            enabled: values.enabled === 'on',
        };
    }

    function l2tpUsersUrl(nodeId, userId) {
        const base = `/panel/nodes/${encodeURIComponent(nodeId)}/l2tp/users`;
        return userId === undefined ? base : `${base}/${encodeURIComponent(userId)}`;
    }

    async function parseResponse(response) {
        try {
            return await response.json();
        } catch {
            return {};
        }
    }

    async function loadL2tpUsers(relay, nodeId, output) {
        const list = relay.querySelector('[data-l2tp-user-list]');
        const empty = relay.querySelector('[data-l2tp-user-empty]');
        const rowTemplate = relay.querySelector('[data-l2tp-user-row]');
        try {
            const response = await fetch(l2tpUsersUrl(nodeId), {
                headers: { 'x-csrf-token': csrfToken },
            });
            const users = await parseResponse(response);
            if (!response.ok || !Array.isArray(users)) {
                setResult(output, users.error?.code || 'USER_LIST_FAILED');
                return;
            }

            list.replaceChildren();
            empty.hidden = users.length !== 0;
            empty.textContent = users.length === 0 ? 'No L2TP users.' : '';
            for (const user of users) {
                const row = rowTemplate.content.firstElementChild.cloneNode(true);
                row.querySelector('[data-l2tp-user-login]').textContent = String(user.login || '');
                row.querySelector('[data-l2tp-user-ip]').textContent = String(user.ip || '');
                row.querySelector('[data-l2tp-user-status]').textContent = user.enabled ? 'Enabled' : 'Disabled';
                row.querySelector('[data-l2tp-user-sync]').textContent = String(user.syncStatus || 'pending');
                const toggle = row.querySelector('[data-l2tp-user-action="toggle"]');
                toggle.textContent = user.enabled ? 'Disable' : 'Enable';
                toggle.addEventListener('click', async () => {
                    toggle.disabled = true;
                    setResult(output, 'Working…');
                    try {
                        const response = await fetch(l2tpUsersUrl(nodeId, user.id), {
                            method: 'PATCH',
                            headers: {
                                'content-type': 'application/json',
                                'x-csrf-token': csrfToken,
                            },
                            body: JSON.stringify({ enabled: !user.enabled }),
                        });
                        const result = await parseResponse(response);
                        if (!response.ok) {
                            setResult(output, result.error?.code || 'USER_UPDATE_FAILED');
                            return;
                        }
                        setResult(output, 'User updated');
                        await loadL2tpUsers(relay, nodeId, output);
                    } catch {
                        setResult(output, 'USER_UPDATE_FAILED');
                    } finally {
                        toggle.disabled = false;
                    }
                });
                list.append(row);
            }
        } catch {
            setResult(output, 'USER_LIST_FAILED');
        }
    }

    document.querySelectorAll('[data-l2tp-relay]').forEach((relay) => {
        const nodeId = relay.dataset.nodeId;
        const form = relay.querySelector('[data-l2tp-form]');
        const output = relay.querySelector('[data-l2tp-result]');
        const userForm = relay.querySelector('[data-l2tp-user-form]');
        const userOutput = relay.querySelector('[data-l2tp-user-result]');

        relay.querySelectorAll('[data-l2tp-action]').forEach((button) => {
            button.addEventListener('click', async () => {
                const values = Object.fromEntries(new FormData(form).entries());
                const action = button.dataset.l2tpAction;
                const payload = action === 'configure'
                    ? buildConfigurePayload(values)
                    : buildOperationPayload(values);

                button.disabled = true;
                setResult(output, 'Working…');
                try {
                    const response = await fetch(`/panel/nodes/${encodeURIComponent(nodeId)}/l2tp/${action}`, {
                        method: 'POST',
                        headers: {
                            'content-type': 'application/json',
                            'x-csrf-token': csrfToken,
                        },
                        body: JSON.stringify(payload),
                    });
                    const result = await response.json();
                    if (!response.ok) {
                        setResult(output, result.error?.code || 'REQUEST_FAILED');
                        return;
                    }
                    setResult(
                        output,
                        result.operationId
                            || (result.ok ? 'OK' : action === 'configure' ? result.status || 'CONFIGURED' : 'FAILED'),
                    );
                } catch {
                    setResult(output, 'REQUEST_FAILED');
                } finally {
                    button.disabled = false;
                }
            });
        });

        userForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            const button = userForm.querySelector('[data-l2tp-user-action="create"]');
            const values = Object.fromEntries(new FormData(userForm).entries());
            button.disabled = true;
            setResult(userOutput, 'Working…');
            try {
                const response = await fetch(l2tpUsersUrl(nodeId), {
                    method: 'POST',
                    headers: {
                        'content-type': 'application/json',
                        'x-csrf-token': csrfToken,
                    },
                    body: JSON.stringify(buildL2tpUserPayload(values)),
                });
                const result = await parseResponse(response);
                if (!response.ok) {
                    setResult(userOutput, result.error?.code || 'USER_CREATE_FAILED');
                    return;
                }
                userForm.reset();
                userForm.querySelector('[name="password"]').value = '';
                setResult(userOutput, 'User added');
                await loadL2tpUsers(relay, nodeId, userOutput);
            } catch {
                setResult(userOutput, 'USER_CREATE_FAILED');
            } finally {
                button.disabled = false;
            }
        });

        void loadL2tpUsers(relay, nodeId, userOutput);
    });
})();
</script>
