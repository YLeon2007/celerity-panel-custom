[Unit]
Description=Fixed TEST private network constructor (manual, independent authority required)
AssertFileNotEmpty=/etc/c3-test-fresh-network.json

AssertPathIsDirectory=/var/lib/c3-test-fresh-network
AssertPathIsDirectory=/run/netns

[Service]
Type=exec
Restart=no
NotifyAccess=main
FileDescriptorStoreMax=16384
FileDescriptorStorePreserve=yes
LimitNOFILE=65536
User=root
Group=root
ExecStart=/usr/bin/python3 -I -B /usr/local/libexec/c3-test-fresh-network-exec.py
UMask=0077
LimitCORE=0
KillMode=process
TimeoutStopSec=30
PrivateMounts=no
